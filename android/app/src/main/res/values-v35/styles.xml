<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 15 draws every app behind the status and navigation bars
         unless it says otherwise. Maites is a web layer in a WebView and has
         no way to pad itself around those bars, so the title landed under
         the clock and the tab bar under the phone's own navigation.

         This opts back out. The proper fix is for the layout to read the
         insets itself, which is the job for when the screens are native. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

</resources>
