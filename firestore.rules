rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /recipes/{recipeId} {
      allow read: if request.auth != null && (
        !('userId' in resource.data) ||
        resource.data.userId == request.auth.uid ||
        exists(/databases/$(database)/documents/shares/$(resource.data.userId + '_' + request.auth.uid))
      );
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        (!('userId' in resource.data) && request.resource.data.userId == request.auth.uid) ||
        (resource.data.userId == request.auth.uid)
      );
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    match /categories/{catId} {
      allow read, write: if request.auth != null;
    }

    match /image_slots/{slotId} {
      allow read, write: if request.auth != null;
    }

    match /invites/{inviteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null;
    }

    match /shares/{shareId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /recipe_shares/{shareId} {
      allow read: if request.auth != null && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toEmail == request.auth.token.email
      );
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow delete: if request.auth != null && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toEmail == request.auth.token.email
      );
    }
  }
}
